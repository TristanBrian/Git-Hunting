# GHOST Environment Variables (Optional)
# If left blank, GHOST will run in Mock Mode (offline) or ask for API keys in the UI.

# OpenAI / OpenRouter API Key (sk-... or sk-or-v1-...)
OPENAI_API_KEY=

# Base URL (e.g., https://api.openai.com/v1 or https://openrouter.ai/api/v1)
API_BASE=

# Model (e.g., gpt-4o, openai/gpt-4o)
MODEL=

# Set to "true" to force Mock Mode even if an API key is present
USE_MOCK=false
